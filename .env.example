# ── Supabase ────────────────────────────────────────────────────────────────
# Copie este arquivo para `.env` e preencha com os dados do SEU projeto Supabase
# (Configurações → API). NUNCA versione o arquivo `.env` real.
#
# Sem essas variáveis, o Atheneu roda em MODO DEMONSTRAÇÃO:
# todos os dados ficam no navegador (localStorage) para você explorar o produto.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── IA (Gemini) — extensão TTS/IA ──────────────────────────────────────────
# Opção A (recomendada): proxy próprio que guarda a chave Gemini no servidor.
# Contrato: POST { prompt, model } → { answer }.
VITE_AI_ENDPOINT=

# Opção B: chave Gemini direto no cliente (site estático). Funciona, mas a
# chave fica visível no bundle — use chave com quotas restritas. Docs:
# docs/GEMINI_AI.md · https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Limites de consumo (opcional — padrões em src/features/ai/config.ts):
# VITE_AI_DAILY_LIMIT=10
# VITE_AI_RATE_LIMIT_SECONDS=5
# VITE_AI_CACHE_DURATION_DAYS=30
# VITE_AI_MAX_CONTEXT=6000
# VITE_AI_MAX_OUTPUT=512
# VITE_AI_MODEL=gemini-2.0-flash
